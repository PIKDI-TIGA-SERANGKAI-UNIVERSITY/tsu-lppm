# [SECURITY] Lapisan kedua: folder sources/ (kode aplikasi, .env, storage, vendor)
# tidak boleh diakses langsung dari web. Aplikasi dimuat lewat ../index.php (filesystem).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
