APP_NAME=MASUKKAN_NAMA_PROYEK
APP_ENV="local" # Ubah ke production jika sudah online
APP_KEY=HAPUS_KALIMAT_INI_DAN_JALANKAN_KEY_GENERATE_DI_TERMINAL
APP_DEBUG="true" # Ganti ke false saat sudah di production
APP_URL="https://tsu-project-template.test/" # Ganti dengan url proyek saat ini

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=MASUKKAN_KONEKSI_HOST_DATABASE
DB_PORT=MASUKKAN_PORT_KONEKSI_DATABASE
DB_DATABASE=MASUKKAN_NAMA_DATABASE
DB_USERNAME=MASUKKAN_USERNAME_DATABASE
DB_PASSWORD=MASUKKAN_PASSWORD_DATABASE

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_COOKIE="template_session" # Ganti dengan nama proyek saat ini, format [nama_proyek]_session atau isi dengan 'session' saja
SESSION_DOMAIN=null

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST="tsu-project-template.test" # Ganti dengan nama host proyek saat ini
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
#MAIL_FROM_NAME="Admin Tiga Serangkai University"
MAIL_FROM_ADDRESS="no-reply@tsu.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Gmaps API Key
GMAPS_KEY=MASUKKAN_GMAPS_KEY

# Homebase Setting
HOMEBASE_URL="https://homebase.tsu.ac.id" # JANGAN DIGANTI

# Feature Flags Starter Kit & Template TSU
FEATURE_DEMO_DASHBOARD=true     # Setel false untuk langsung beralih ke kanvas dashboard kosong (blank starter canvas)
FEATURE_DEMO_LANDING_PAGE=true  # Setel false untuk beralih ke kanvas landing page kosong (blank starter landing page)
FEATURE_MANUAL_BOOK=true        # Setel false untuk menyembunyikan buku panduan pengembang & icon di navbar
FEATURE_WELCOME_SPLASH=true     # Setel false untuk menonaktifkan layar transisi sambutan pasca-login
FEATURE_TOP_PROGRESS_BAR=true   # Setel false untuk menonaktifkan indikator garis progress tipis di atas layar

# HRIS Setting (Sinkronisasi Data Karyawan)
# Default: false (Hanya aktif jika true DAN HRIS_SYNC_SECRET terisi sah dari PIKDI)
FEATURE_DATA_KARYAWAN=false
HRIS_URL="https://hris.tsu.ac.id" # Ganti dengan URL/Host TSU HRIS
HRIS_SYNC_SECRET=MASUKKAN_HASH_SHA256_DARI_HRIS_SECRET # Hash SHA-256 dari PIKDI (admin HRIS yang membuatnya), bukan secret aslinya. Jangan diisi plaintext

# Login SSO TSU Homebase (Authorization Code). Diterbitkan PIKDI per aplikasi: minta ke Helpdesk PIKDI
# (WhatsApp +62 851-1141-5175 / pikdi@tsu.ac.id). Selama masih teks contoh, tombol login SSO menampilkan
# halaman "Login SSO Belum Dikonfigurasi" berisi URL callback Anda dan teks permintaan siap kirim.
# REDIRECT_URI harus sama persis dengan alamat yang Anda buka, mis. http://localhost/nama-proyek/login/sso/callback
TSU_SSO_CLIENT_ID=MASUKKAN_CLIENT_ID_DARI_TSU_HOMEBASE
TSU_SSO_CLIENT_SECRET=MASUKKAN_CLIENT_SECRET_DARI_TSU_HOMEBASE
TSU_SSO_REDIRECT_URI="https://[url_proyek]/login/sso/callback"

# Client Credentials (API Homebase: sinkronisasi user & role). Diminta ke PIKDI bila aplikasi memakainya.
HOMEBASE_CLIENT_ID=MASUKKAN_CLIENT_ID_DARI_TSU_HOMEBASE
HOMEBASE_CLIENT_SECRET=MASUKKAN_CLIENT_SECRET_DARI_TSU_HOMEBASE

# Kunci API penarikan Activity Log oleh Homebase (header X-TSU-HOMEBASE-KEY)
# WAJIB sama dengan yang dikirim Homebase. Biarkan kosong = endpoint /v1/system/activity-logs menolak semua request.
# Generate: php -r "echo bin2hex(random_bytes(32));"
TSU_HOMEBASE_SECRET_KEY=

# Settings Module
MODULE_FULL_NAME="tsu_template" # Kecil semua dan spasi diganti "_", JANGAN DI KOSONGI
MODULE_NAME="template" # Kecil semua dan spasi diganti "_", JANGAN DI KOSONGI
MODULE_TITLE_ACRONYMS="tsu,sso,api,hris,pikdi,siakad,sim" # Singkatan yang otomatis dijadikan UPPERCASE pada judul modul (pisahkan dengan koma)
TABLE_NAME="" # Bisa dengan [nama proyek] atau kosongi menjadi "" untuk default nama table

# ==============================================================================
# AKUN PENGEMBANG LOKAL (LOCAL DEV MODE)
# Hanya otomatis di-seed jika APP_ENV=local untuk memudahkan mahasiswa/vendor
# melakukan pengujian dan pengembangan modul secara offline tanpa SSO kampus.
# ==============================================================================
DEV_ADMIN_NAME="Pengembang Modul TSU"
DEV_ADMIN_USERNAME="devadmin"
DEV_ADMIN_EMAIL="dev.admin@tsu.ac.id"
DEV_ADMIN_PASSWORD="password@123"

# ==============================================================================
# PROTOKOL AKSES DARURAT PUSAT & BREAK-GLASS (PIKDI EMERGENCY PROTOCOL)
# Bagian ini dikonfigurasi oleh tim PIKDI di server kampus (APP_ENV=production).
# Mahasiswa lokal dapat mengosongkannya atau mengisi dummy untuk simulasi.
# ==============================================================================
# Email resmi penerima audit trail keamanan & OTP tsu:create-admin
PIKDI_ADMIN_EMAIL="pikdi@tsu.ac.id"

# Kontak Helpdesk PIKDI yang tampil di aplikasi (tombol bantuan, halaman error, halaman SSO).
# Default sudah benar, isi hanya bila kontak berubah.
# PIKDI_SUPPORT_EMAIL="pikdi@tsu.ac.id"
# PIKDI_SUPPORT_WHATSAPP="6285111415175"

# Signature HMAC-SHA256 URL Direct Jump dari Portal Homebase (/emergency-login)
PIKDI_EMERGENCY_SECRET=

# Bcrypt Hash Kunci Akses Mandiri jika Server SSO Homebase Down (/rescue-login)
PIKDI_RESCUE_SECRET=

# Master Passphrase Otorisasi CLI Inject Super Admin (php artisan tsu:create-admin)
# Wajib diisi tersendiri (tidak lagi fallback ke PIKDI_EMERGENCY_SECRET)
PIKDI_COMMAND_SECRET=

# API Secret Token untuk Sinkronisasi ke Homebase
PIKDI_SYNC_SECRET=

# --- ROLE PERMISSION ---
# Pisahkan dengan koma. Contoh: dosen,tendik
# Kosongkan jika ingin mengizinkan SEMUA role.
APP_ALLOWED_ROLES=

# --- PESERTA PENGEMBANG (magang, PKL, mitra) ---
# Tolak login & putus sesi peserta eksternal yang masa tugasnya berakhir (pengaman kedua; pembatasan utama di Homebase).
# Setel false bila aplikasi tidak memakai peserta eksternal.
TSU_ASSIGNMENT_ENFORCE=true
# Jadwalkan tsu:assignments-expire setiap hari untuk mencabut role lokal peserta yang masa tugasnya habis
# (butuh scheduler aplikasi: cron `php artisan schedule:run` tiap menit).
TSU_ASSIGNMENT_SCHEDULE=true
# Rekomendasi: staging APP_ALLOWED_ROLES=dosen,tendik,mahasiswa,magang,pkl,mitra ; production tanpa magang,pkl,mitra.

# --- BROADCAST & WEBSOCKET ---
# Notes for Development:
# REVERB_HOST="localhost"
# REVERB_PORT=8080
# REVERB_SCHEME=http
#
# Notes for Production:
# REVERB_HOST="ws.domainanda.com" (Ganti dengan IP atau Subdomain server WebSockets)
# REVERB_PORT=443 (Gunakan 443 jika menggunakan HTTPS/WSS, atau port reverse proxy)
# REVERB_SCHEME=https
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
MIX_REVERB_APP_KEY="${REVERB_APP_KEY}"
MIX_REVERB_HOST="${REVERB_HOST}"
MIX_REVERB_PORT="${REVERB_PORT}"
MIX_REVERB_SCHEME="${REVERB_SCHEME}"

# =====================================================================
# TSU DOKUMENTASI & MANUAL BOOK
# =====================================================================
# Kosongkan untuk menggunakan built-in viewer (/panduan)
# atau isi URL eksternal (misal: https://docs.tsu.ac.id/developer-guide)
TSU_MANUAL_BOOK_URL=
