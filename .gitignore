# --- 1. SAMPAH SISTEM OPERASI (Wajib) ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- 2. SAMPAH EDITOR / IDE ---
.idea
.vscode
.fleet
*.swp
*.swo
*.sublime-workspace
*.iml

# --- 3. SCRATCH & TEMPORARY SCRIPTS ---
scratch/
sources/scratch/
*.tmp
*.temp
*.bak

# --- 4. BACKUP & DATABASE DUMPS ---
*.sql
*.sqlite
*.sqlite-journal
*.zip
*.tar.gz
*.rar
*.7z

# --- 5. BLOKIR KERAS FOLDER 'SOURCES' (Safety Net) ---
# Kita tulis path lengkap biar Git di Root gak salah paham

# > Keamanan & Environment
sources/.env
sources/.env.*
!sources/.env.example
sources/auth.json
sources/*.key
sources/*.pem
sources/*.crt

# > Dependencies (Berat & Ribuan File)
sources/vendor
sources/node_modules

# > Laravel Modules Dependencies & Builds
sources/Modules/*/node_modules/
sources/Modules/*/vendor/
sources/Modules/*/public/build/
sources/Modules/*/public/hot
sources/Modules/*/.env

# > Kunci Rahasia SSO/Passport
sources/storage/*.key
sources/storage/oauth-*.key

# > Log & Cache Laravel
sources/storage/logs/*.log
sources/storage/framework/views/*.php
sources/storage/framework/cache/data/*
sources/storage/framework/sessions/*
sources/storage/framework/testing/*

# > Lain-lain
sources/.phpunit.result.cache
sources/.phpunit.cache/
sources/.php-cs-fixer.cache
sources/bootstrap/cache/*.php
!sources/bootstrap/cache/.gitignore
sources/npm-debug.log
sources/yarn-error.log

# --- 6. FOLDER PUBLIC (Di Luar Sources) ---
public/storage
public/hot
public/build
# > Aset UI hasil publish package (pikdi/tsu-core, dll). Dibuat ulang otomatis saat
#   composer install/update (vendor:publish --tag=laravel-assets).
public/vendor/
